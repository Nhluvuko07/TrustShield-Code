# Speech recognition and synthesis functions
def speech_to_text():
    recognizer = sr.Recognizer()
    with sr.Microphone() as source:
        print("Please speak your transaction details...")
        audio = recognizer.listen(source)
    
    try:
        text = recognizer.recognize_google(audio)
        print(f"You said: {text}")
        return text
    except sr.UnknownValueError:
        print("Sorry, I could not understand the audio.")
        return ""
    except sr.RequestError as e:
        print(f"Could not request results from Google Speech Recognition service; {e}")
        return ""

def text_to_speech(text):
    engine = pyttsx3.init()
    engine.say(text)
    engine.runAndWait()

# Chatbot for fraud detection queries
def fraud_detection_chatbot():
    print("Welcome to the Fraud Detection Assistant!")
    text_to_speech("Welcome to the Fraud Detection Assistant!")
    
    while True:
        print("\nHow can I help you?")
        print("1. Check a transaction for fraud")
        print("2. Explain fraud detection results")
        print("3. Exit")
        
        choice = input("Please choose an option (1-3): ")
        
        if choice == "1":
            print("Please provide transaction details:")
            transaction_text = speech_to_text()
            
            if transaction_text:
                # Process the transaction (simplified example)
                print("Analyzing transaction...")
                # In a real implementation, you would parse the speech input and process it
                text_to_speech("I've analyzed your transaction. Please check the console for details.")
                
        elif choice == "2":
            explanation = """
            Our fraud detection system uses machine learning to identify suspicious transactions.
            It analyzes various features including transaction amount, type, time, and description.
            The system has an accuracy of over 95% in detecting fraudulent activities.
            """
            print(explanation)
            text_to_speech(explanation)
            
        elif choice == "3":
            print("Thank you for using the Fraud Detection Assistant!")
            text_to_speech("Goodbye!")
            break
            
        else:
            print("Invalid option. Please try again.")

